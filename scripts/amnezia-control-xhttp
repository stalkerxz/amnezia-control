#!/usr/bin/env python3
"""Safely hot-add, hot-remove, or verify one managed XHTTP client in Xray."""

from __future__ import annotations

import copy
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from uuid import UUID

CONFIG_PATH = Path("/usr/local/etc/xray/config.json")
XRAY_BIN = Path("/usr/local/bin/xray")
XRAY_SERVICE = "xray"
XRAY_API_SERVER = "127.0.0.1:10085"
LOCK_PATH = Path("/run/lock/amnezia-control-xhttp.lock")
BACKUP_DIR = Path("/var/backups/amnezia-control")
INBOUND_TAG = "vless-xhttp-yandex"
INBOUND_LISTEN = "127.0.0.1"
INBOUND_PORT = 8080
XHTTP_PATH = "/api/ad4f850643d5e660f09d31f9"
EMAIL_RE = re.compile(r"xhttp-[0-9a-f]{32}")


class ManagedError(RuntimeError):
    pass


def emit(payload: dict, *, stream=sys.stdout) -> None:
    print(json.dumps(payload, ensure_ascii=False, sort_keys=True), file=stream)


def run(command: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        command,
        check=False,
        capture_output=True,
        text=True,
        timeout=30,
    )
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout or "command failed").strip().splitlines()
        message = detail[-1] if detail else "command failed"
        raise ManagedError(f"Команда завершилась с ошибкой: {message[:240]}")
    return result


def validate_identity(uuid_text: str, email: str) -> tuple[str, str]:
    try:
        normalized_uuid = str(UUID(uuid_text))
    except ValueError as exc:
        raise ManagedError("Некорректный UUID.") from exc
    if normalized_uuid != uuid_text.lower():
        raise ManagedError("UUID должен быть в каноническом формате.")
    if not EMAIL_RE.fullmatch(email):
        raise ManagedError("Некорректная техническая метка клиента.")
    expected_email = f"xhttp-{UUID(normalized_uuid).hex}"
    if email != expected_email:
        raise ManagedError("Техническая метка не соответствует UUID клиента.")
    return normalized_uuid, email


def load_config(path: Path) -> dict:
    try:
        with path.open("r", encoding="utf-8") as handle:
            value = json.load(handle)
    except (OSError, json.JSONDecodeError) as exc:
        raise ManagedError("Не удалось прочитать корректную конфигурацию Xray.") from exc
    if not isinstance(value, dict):
        raise ManagedError("Корневая структура конфигурации Xray должна быть объектом.")
    return value


def find_inbound(config: dict) -> dict:
    inbounds = config.get("inbounds")
    if not isinstance(inbounds, list):
        raise ManagedError("В конфигурации Xray отсутствует список inbounds.")

    for inbound in inbounds:
        if isinstance(inbound, dict) and inbound.get("tag") == INBOUND_TAG:
            return inbound

    for inbound in inbounds:
        if not isinstance(inbound, dict):
            continue
        stream = inbound.get("streamSettings") or {}
        xhttp = stream.get("xhttpSettings") or {}
        if (
            inbound.get("protocol") == "vless"
            and inbound.get("listen") == INBOUND_LISTEN
            and inbound.get("port") == INBOUND_PORT
            and stream.get("network") == "xhttp"
            and xhttp.get("path") == XHTTP_PATH
        ):
            return inbound

    raise ManagedError("Управляемый VLESS/XHTTP inbound не найден.")


def client_list(inbound: dict) -> list[dict]:
    settings = inbound.setdefault("settings", {})
    clients = settings.setdefault("clients", [])
    if not isinstance(clients, list):
        raise ManagedError("settings.clients должен быть списком.")
    if any(not isinstance(client, dict) for client in clients):
        raise ManagedError("В settings.clients найдена некорректная запись.")
    return clients


def identity_state(clients: list[dict], uuid_text: str, email: str) -> bool:
    exact = [item for item in clients if item.get("id") == uuid_text and item.get("email") == email]
    uuid_matches = [item for item in clients if item.get("id") == uuid_text]
    email_matches = [item for item in clients if item.get("email") == email]

    if len(exact) == 1 and len(uuid_matches) == 1 and len(email_matches) == 1:
        return True
    if not exact and not uuid_matches and not email_matches:
        return False
    raise ManagedError("UUID или техническая метка конфликтуют с другой записью.")


def mutate(config: dict, action: str, uuid_text: str, email: str) -> bool:
    clients = client_list(find_inbound(config))
    present = identity_state(clients, uuid_text, email)

    if action == "check":
        if not present:
            raise ManagedError("Клиент не найден в конфигурации Xray.")
        return False

    if action == "add":
        if present:
            return False
        clients.append({"id": uuid_text, "email": email})
        return True

    if action == "remove":
        if not present:
            return False
        clients[:] = [
            item
            for item in clients
            if not (item.get("id") == uuid_text and item.get("email") == email)
        ]
        return True

    raise ManagedError("Неизвестное действие.")


def test_config(path: Path) -> None:
    if not XRAY_BIN.is_file():
        raise ManagedError("Исполняемый файл Xray не найден.")
    run([str(XRAY_BIN), "run", "-test", "-config", str(path)])


def ensure_service_active() -> None:
    result = run(["systemctl", "is-active", "--quiet", XRAY_SERVICE], check=False)
    if result.returncode != 0:
        raise ManagedError("Сервис Xray не активен.")


def ensure_handler_api_config(config: dict) -> None:
    api = config.get("api")
    if not isinstance(api, dict):
        raise ManagedError("Xray Handler API не настроен.")
    if api.get("listen") != XRAY_API_SERVER:
        raise ManagedError("Xray Handler API слушает неожиданный адрес.")
    services = api.get("services") or []
    if "HandlerService" not in services:
        raise ManagedError("Xray HandlerService не включён.")
    inbound = find_inbound(config)
    if inbound.get("tag") != INBOUND_TAG:
        raise ManagedError("Управляемый XHTTP inbound не имеет ожидаемый tag.")


def runtime_users() -> list[dict]:
    result = run(
        [
            str(XRAY_BIN),
            "api",
            "inbounduser",
            f"--server={XRAY_API_SERVER}",
            f"-tag={INBOUND_TAG}",
        ]
    )
    try:
        payload = json.loads(result.stdout or "{}")
    except json.JSONDecodeError as exc:
        raise ManagedError("Handler API вернул некорректный JSON.") from exc

    raw_users = payload.get("users") or []
    if not isinstance(raw_users, list):
        raise ManagedError("Handler API вернул некорректный список пользователей.")

    users = []
    for item in raw_users:
        if not isinstance(item, dict):
            raise ManagedError("Handler API вернул некорректную запись пользователя.")
        account = item.get("account") or {}
        user_id = account.get("id")
        email = item.get("email")
        if user_id and email:
            users.append({"id": str(user_id), "email": str(email)})
    return users


def write_temp_config(config: dict, *, directory: Path, original_stat: os.stat_result | None = None) -> Path:
    fd, raw_path = tempfile.mkstemp(
        prefix=".amnezia-control-xhttp-",
        suffix=".json",
        dir=str(directory),
        text=True,
    )
    temp_path = Path(raw_path)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(config, handle, ensure_ascii=False, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        if original_stat is not None:
            os.chmod(temp_path, stat.S_IMODE(original_stat.st_mode))
            os.chown(temp_path, original_stat.st_uid, original_stat.st_gid)
        return temp_path
    except Exception:
        temp_path.unlink(missing_ok=True)
        raise


def fsync_directory(path: Path) -> None:
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def backup_config() -> Path:
    BACKUP_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    destination = BACKUP_DIR / f"xray-config-{stamp}.json"
    shutil.copy2(CONFIG_PATH, destination)
    os.chmod(destination, 0o600)
    backups = sorted(BACKUP_DIR.glob("xray-config-*.json"), reverse=True)
    for stale in backups[50:]:
        stale.unlink(missing_ok=True)
    return destination


def replace_persisted_config(config: dict) -> Path:
    original_stat = CONFIG_PATH.stat()
    backup = backup_config()
    temp_path = write_temp_config(
        config,
        directory=CONFIG_PATH.parent,
        original_stat=original_stat,
    )
    try:
        test_config(temp_path)
        os.replace(temp_path, CONFIG_PATH)
        fsync_directory(CONFIG_PATH.parent)
        test_config(CONFIG_PATH)
        return backup
    except Exception:
        temp_path.unlink(missing_ok=True)
        raise


def restore_persisted_config(backup: Path) -> None:
    backup_config_value = load_config(backup)
    original_stat = CONFIG_PATH.stat()
    temp_path = write_temp_config(
        backup_config_value,
        directory=CONFIG_PATH.parent,
        original_stat=original_stat,
    )
    try:
        test_config(temp_path)
        os.replace(temp_path, CONFIG_PATH)
        fsync_directory(CONFIG_PATH.parent)
        test_config(CONFIG_PATH)
    finally:
        temp_path.unlink(missing_ok=True)


def build_single_user_api_config(config: dict, uuid_text: str, email: str) -> dict:
    inbound = copy.deepcopy(find_inbound(config))
    inbound.setdefault("settings", {})["clients"] = [
        {"id": uuid_text, "email": email}
    ]
    return {
        "log": {"loglevel": "warning"},
        "inbounds": [inbound],
        "outbounds": [
            {
                "tag": "direct",
                "protocol": "freedom",
                "settings": {},
            }
        ],
    }


def hot_add(config: dict, uuid_text: str, email: str) -> None:
    api_config = build_single_user_api_config(config, uuid_text, email)
    temp_path = write_temp_config(api_config, directory=Path("/tmp"))
    try:
        test_config(temp_path)
        run(
            [
                str(XRAY_BIN),
                "api",
                "adu",
                f"--server={XRAY_API_SERVER}",
                str(temp_path),
            ]
        )
    finally:
        temp_path.unlink(missing_ok=True)


def hot_remove(email: str) -> None:
    run(
        [
            str(XRAY_BIN),
            "api",
            "rmu",
            f"--server={XRAY_API_SERVER}",
            f"-tag={INBOUND_TAG}",
            email,
        ]
    )


def ensure_runtime_state(config: dict, uuid_text: str, email: str, *, present: bool) -> None:
    current = identity_state(runtime_users(), uuid_text, email)
    if current == present:
        return
    if present:
        hot_add(config, uuid_text, email)
    else:
        hot_remove(email)
    final = identity_state(runtime_users(), uuid_text, email)
    if final != present:
        raise ManagedError("Не удалось восстановить runtime-состояние Xray.")


def apply_action(action: str, uuid_text: str, email: str) -> tuple[bool, Path | None]:
    original_config = load_config(CONFIG_PATH)
    ensure_handler_api_config(original_config)
    ensure_service_active()
    test_config(CONFIG_PATH)

    file_present_before = identity_state(
        client_list(find_inbound(original_config)),
        uuid_text,
        email,
    )
    runtime_present_before = identity_state(runtime_users(), uuid_text, email)

    if action == "check":
        if not file_present_before or not runtime_present_before:
            raise ManagedError("Клиент отсутствует в persisted config или running Xray.")
        return False, None

    desired_present = action == "add"
    if action not in {"add", "remove"}:
        raise ManagedError("Неизвестное действие.")

    desired_config = copy.deepcopy(original_config)
    file_changed = mutate(desired_config, action, uuid_text, email)
    runtime_changed = runtime_present_before != desired_present
    backup = None

    try:
        if file_changed:
            backup = replace_persisted_config(desired_config)

        if runtime_changed:
            if desired_present:
                hot_add(desired_config, uuid_text, email)
            else:
                hot_remove(email)

        persisted_after = load_config(CONFIG_PATH)
        ensure_handler_api_config(persisted_after)
        file_present_after = identity_state(
            client_list(find_inbound(persisted_after)),
            uuid_text,
            email,
        )
        runtime_present_after = identity_state(runtime_users(), uuid_text, email)

        if file_present_after != desired_present or runtime_present_after != desired_present:
            raise ManagedError("Persisted config и running Xray не сошлись после операции.")

        return file_changed or runtime_changed, backup

    except Exception as exc:
        rollback_errors = []

        if backup is not None:
            try:
                restore_persisted_config(backup)
            except Exception as rollback_exc:
                rollback_errors.append(f"config rollback: {rollback_exc}")

        try:
            ensure_runtime_state(
                original_config,
                uuid_text,
                email,
                present=runtime_present_before,
            )
        except Exception as rollback_exc:
            rollback_errors.append(f"runtime rollback: {rollback_exc}")

        if rollback_errors:
            raise ManagedError(
                "Операция XHTTP завершилась ошибкой, а автоматический откат неполон: "
                + "; ".join(rollback_errors)
            ) from exc

        raise ManagedError(f"Операция XHTTP отменена автоматическим откатом: {exc}") from exc


def main() -> int:
    if os.geteuid() != 0:
        raise ManagedError("Скрипт должен выполняться от root.")
    if len(sys.argv) != 4:
        raise ManagedError("Использование: amnezia-control-xhttp add|remove|check UUID EMAIL")

    action = sys.argv[1]
    if action not in {"add", "remove", "check"}:
        raise ManagedError("Разрешены только add, remove и check.")
    uuid_text, email = validate_identity(sys.argv[2], sys.argv[3])

    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_PATH.open("a+", encoding="utf-8") as lock_handle:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        changed, backup = apply_action(action, uuid_text, email)

    emit(
        {
            "ok": True,
            "action": action,
            "changed": changed,
            "backup": str(backup) if backup else None,
            "runtime": "hot-api",
            "xray_restarted": False,
        }
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except ManagedError as exc:
        emit({"ok": False, "error": str(exc)}, stream=sys.stderr)
        raise SystemExit(1)
    except Exception:
        emit({"ok": False, "error": "Непредвиденная ошибка helper-скрипта."}, stream=sys.stderr)
        raise SystemExit(1)
